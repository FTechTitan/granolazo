# Configuracion de compilacion de la app de Granolazo.
# Copiar a granolazo.env y completar. granolazo.env NO se versiona.
#
#   flutter run          --dart-define-from-file=granolazo.env
#   flutter build apk    --dart-define-from-file=granolazo.env --release
#   flutter build windows --dart-define-from-file=granolazo.env --release
#
# La clave anon es la MISMA que usa el panel web (web/.env). Nunca poner aqui la
# service_role: esto se compila dentro de un instalable.
GRANOLAZO_URL=https://your-project.supabase.example
GRANOLAZO_ANON_KEY=
GRANOLAZO_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Opcional: apuntar a una funcion propia para que la clave de transcripcion no viva
# en el dispositivo.
# GRANOLAZO_TRANSCRIPTION_ENDPOINT=https://your-project.supabase.example/functions/v1/transcribir
